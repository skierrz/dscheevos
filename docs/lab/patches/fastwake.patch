diff --git a/dscheevos/core/include/dscheevos.h b/dscheevos/core/include/dscheevos.h
index ca5839a9..9633e209 100644
--- a/dscheevos/core/include/dscheevos.h
+++ b/dscheevos/core/include/dscheevos.h
@@ -248,6 +248,9 @@ int dsc_work_pending(void);
  * as dsc_capture and dsc_idle do first. Lets the platform do that work with
  * interrupts enabled before a capture that runs with them masked. */
 void dsc_drain(void);
+/* capture once only: the newest frame is captured and committed (nothing for
+ * dsc_capture/dsc_drain to do until the next VBlank). */
+int dsc_frame_done(void);
 
 /* DS: before dsc_init, which view of RAM the core's own state is used
  * through: 0x02000000 (cached) or 0x0C000000 (the mirror). No-op elsewhere. */
diff --git a/dscheevos/core/src/dscheevos.c b/dscheevos/core/src/dscheevos.c
index b3d1b93f..9fa51e28 100644
--- a/dscheevos/core/src/dscheevos.c
+++ b/dscheevos/core/src/dscheevos.c
@@ -4106,6 +4106,14 @@ WAKE void dsc_drain(void)
     drain();
 }
 
+/* For the module's fast idle wake: with capture once, the newest frame has
+ * its capture and is committed, so until the next VBlank a capture (and a
+ * drain) would take nothing. */
+WAKE int dsc_frame_done(void)
+{
+  return S.initialized && S.active && S.config.capture_at_halt == DSC_CAPTURE_ONCE && Q.taken == Q.frames;
+}
+
 COLD uint32_t dsc_arena_used(void)
 {
   uint32_t tail;
